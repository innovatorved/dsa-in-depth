{
  "name": "dsa-in-depth",
  "version": "1.0.0",
  "description": "Data Structures & Algorithms In Depth — Open-source interactive curriculum, 69 step-by-step visualizers, and browser-native C++20/TypeScript coding labs.",
  "homepage": "https://dsa-in-depth.vedgupta.in",
  "scripts": {
    "build": "node tools/build.js",
    "og": "node tools/generate-og.js",
    "validate": "node tools/validate.js",
    "check:rendered": "node tools/check-rendered.js",
    "test": "node tools/validate.js && node tools/check-rendered.js",
    "lint": "node tools/validate.js",
    "typecheck": "node tools/check-rendered.js",
    "stamp": "node tools/stamp-assets.js",
    "stamp:check": "node tools/stamp-assets.js --check",
    "prerender": "node tools/generate-static.js",
    "serve": "python3 -m http.server 8000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/innovatorved/dsa-in-depth.git"
  },
  "bugs": {
    "url": "https://github.com/innovatorved/dsa-in-depth/issues"
  },
  "keywords": [
    "algorithms",
    "data-structures",
    "computer-science",
    "interactive-simulators",
    "cpp20",
    "webassembly",
    "code-lab"
  ],
  "author": "Ved Gupta (https://vedgupta.in)",
  "license": "MIT AND CC-BY-4.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@innovatorved/code-lab": "^0.7.0",
    "katex": "^0.19.1"
  }
}
